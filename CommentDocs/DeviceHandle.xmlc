<group prefix="WebGpuSharp.FFI.">
	<comment location="DeviceHandle.">
		<summary>A DeviceHandle encapsulates a graphics/compute device and exposes the functionality of that device.</summary> 
	</comment>
	<group prefix="DeviceHandle.">
		<comment location="CreateBindGroup">
			<summary>Creates a BindGroup.</summary>
			<param name="descriptor">The descriptor to use for the BindGroup</param>
			<returns>A new BindGroup</returns>
		</comment>
		<comment location="CreateBindGroupLayout">
			<summary>Creates a BindGroupLayout.</summary>
			<param name="descriptor">The descriptor to use for the BindGroupLayout</param>
			<returns>A new BindGroupLayout</returns>
		</comment>
		<comment location="CreateBuffer">
			<summary>Creates a Buffer.</summary>
			<param name="descriptor">The descriptor to use for the Buffer</param>
			<returns>A new Buffer</returns>
		</comment>
		<comment location="CreateCommandEncoder">
			<summary>Creates a CommandEncoder.</summary>
			<param name="descriptor">The descriptor to use for the CommandEncoder</param>
			<returns>A new CommandEncoder</returns>
		</comment>
		<comment location="CreateComputePipeline">
			<summary>Creates a ComputePipeline using immediate pipeline creation.</summary>
			<param name="descriptor">The descriptor to use for the ComputePipeline</param>
			<returns>A new ComputePipeline</returns>
		</comment>
		<comment location="CreateComputePipelineAsync">
			<summary>
				Creates a GPUComputePipeline using async pipeline creation. 
				The returned future resolves when the created pipeline is ready to be used without additional delay.
			</summary>
			<param name="descriptor">The descriptor to use for the ComputePipeline</param>
			<param name="callbackInfo">The callbackInfo to use for the ComputePipeline</param>
			<remark>
				Use of this method is preferred whenever possible, as it prevents blocking the queue timeline work on pipeline compilation.
			</remark>
			<returns>A future resolving when the pipeline is ready</returns>
		</comment>
		<comment location="CreatePipelineLayout">
			<summary>Creates a PipelineLayout.</summary>
		</comment>
		<comment location="CreateQuerySet">
			<summary>Creates a QuerySet.</summary>
			<param name="descriptor"> The descriptor to use for the QuerySet</param>
			<returns>A new QuerySet</returns>
		</comment>
		<comment location="CreateRenderBundleEncoder">
			<summary>Creates a RenderBundleEncoder.</summary>
			<param name="descriptor">The descriptor to use for the RenderBundleEncoder</param>
			<returns>A new RenderBundleEncoder</returns>
		</comment>
		<comment location="CreateRenderPipeline">
			<summary>Creates a GPURenderPipeline using immediate pipeline creation.</summary>
			<param name="descriptor">The descriptor to use for the RenderPipeline</param>
			<returns>A new RenderPipeline</returns>
		</comment>
		<comment location="CreateRenderPipelineAsync">
			<summary>
				Creates a GPURenderPipeline using async pipeline creation. 
				The returned future resolves when the created pipeline is ready to be used without additional delay.
			</summary>
			<param name="descriptor">The descriptor to use for the RenderPipeline</param>
			<param name="callbackInfo">The callbackInfo to use for the RenderPipeline</param>
			<remark>
				Use of this method is preferred whenever possible, as it prevents blocking the queue timeline work on pipeline compilation.
			</remark>
			<returns>A future resolving when the pipeline is ready</returns>
		</comment>
		<comment location="CreateSampler">
			<summary>Creates a Sampler.</summary>
			<param name="descriptor">The descriptor to use for the Sampler</param>
			<returns>A new Sampler</returns>
		</comment>
		<comment location="CreateShaderModule">
			<summary>Creates a ShaderModule.</summary>
			<param name="descriptor">The descriptor to use for the ShaderModule</param>
			<returns>A new ShaderModule</returns>
		</comment>
		<comment location="CreateTexture">
			<summary>Creates a Texture.</summary>
			<param name="descriptor">The descriptor to use for the Texture</param>
			<returns>A new Texture</returns>
		</comment>
		<comment location="Destroy">
			<summary>Destroys the device, preventing further operations on it. Outstanding asynchronous operations will fail.</summary>
			<remark> It is valid to destroy a device multiple times.</remark>
			<returns>A future resolving when the device is destroyed</returns>
		</comment>
		<comment location="GetAdapterInfo">
			<summary>
				Information about the physical adapter which created the device that this GPUDevice refers to.

				For a given GPUDevice, the GPUAdapterInfo values exposed are constant over time.
			</summary>
			<param name="adapterInfo">The adapterInfo to insert the adapter info into</param>
			<returns> the status of the operation</returns>
		</comment>
		<comment location="GetFeatures">
			<summary>Get the features supported by the device</summary>
			<param name="features">an pointer to a SupportedFeaturesFFI to insert the supported features into</param>
		</comment>
		<comment location="GetLimits">
			<summary>
				Get the limits which can be used on this device.
				No better limits can be used, even if the underlying adapter can support them.
			</summary>
			<param name="limits">an pointer to a SupportedLimits to insert the limits into</param>
			<returns>Return status of the operation</returns>
		</comment>
		<comment location="GetLostFuture">
		</comment>
		<comment location="GetQueue">
			<summary>
				Get the primary Queue for this device.
			</summary>
			<param name="queue">Get the queue to insert command into</param>
			<returns>the queue</returns>
		</comment>
		<comment location="HasFeature">
			<summary>Check if the feature is supported</summary>
			<param name="feature">The feature to check</param>
			<returns>true if the feature is supported false otherwise</returns>
		</comment>
		<comment location="PopErrorScope(delegate* unmanaged[Cdecl]&lt;WebGpuSharp.ErrorType, WebGpuSharp.FFI.StringViewFFI, void*, void>, void*)">
			<summary>
				Pops a error scope off the errorScopeStack for this and resolves to any error observed by the error scope, or null if none.
			</summary>
			<param name="oldCallback">The callback to call when the error scope is popped.</param>
			<param name="userdata">The userdata to pass to the callback.</param>
		</comment>
		<comment location="PopErrorScope(WebGpuSharp.FFI.PopErrorScopeCallbackInfo2FFI)">
			<summary>
				Pops a error scope off the errorScopeStack for this device and resolves to any error observed by the error scope, or null if none.
			</summary>
			<param name="callbackInfo">The callback to call when the error scope is popped.</param>
			<returns>a future resolving when the error from the error scope is ready to be observed</returns>
		</comment>
		<comment location="PushErrorScope">
			<summary>Pushes a new error scope onto the errorScopeStack for this device</summary>
			<param name="filter">Which class of errors this error scope observes</param>
		</comment>
		<comment location="SetLabel">
			<summary>Set debug label of this device</summary>
			<param name="label">The label to set</param>
		</comment>
	</group>
</group>
