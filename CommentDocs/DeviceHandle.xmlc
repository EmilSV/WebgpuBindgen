	public static explicit operator nuint (WebGpuSharp.FFI.DeviceHandle handle)=> handle._ptr;

	public static bool operator ==(WebGpuSharp.FFI.DeviceHandle left, WebGpuSharp.FFI.DeviceHandle right)=> left._ptr == right._ptr;

	public static bool operator !=(WebGpuSharp.FFI.DeviceHandle left, WebGpuSharp.FFI.DeviceHandle right)=> left._ptr != right._ptr;

	public static bool operator ==(WebGpuSharp.FFI.DeviceHandle left, WebGpuSharp.FFI.DeviceHandle? right)=> left._ptr == right.GetValueOrDefault()._ptr;

	public static bool operator !=(WebGpuSharp.FFI.DeviceHandle left, WebGpuSharp.FFI.DeviceHandle? right)=> left._ptr != right.GetValueOrDefault()._ptr;

	public static bool operator ==(WebGpuSharp.FFI.DeviceHandle left, nuint right)=> left._ptr == right;

	public static bool operator !=(WebGpuSharp.FFI.DeviceHandle left, nuint right)=> left._ptr != right;

	public nuint GetAddress()=> _ptr;

	public bool Equals(WebGpuSharp.FFI.DeviceHandle other)=> _ptr == other._ptr;

	public override bool Equals(object? other)=> (other is DeviceHandle h && Equals(h)) || (other is null && _ptr == UIntPtr.Zero);

	public override int GetHashCode()=> _ptr.GetHashCode();

	public WebGpuSharp.FFI.BindGroupHandle CreateBindGroup(WebGpuSharp.FFI.BindGroupDescriptorFFI* descriptor)=> WebGPU_FFI.DeviceCreateBindGroup(this, descriptor);

	public WebGpuSharp.FFI.BindGroupLayoutHandle CreateBindGroupLayout(WebGpuSharp.FFI.BindGroupLayoutDescriptorFFI* descriptor)=> WebGPU_FFI.DeviceCreateBindGroupLayout(this, descriptor);

