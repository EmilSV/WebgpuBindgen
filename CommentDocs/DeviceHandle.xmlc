	public WebGpuSharp.FFI.TextureHandle CreateTexture(WebGpuSharp.FFI.TextureDescriptorFFI* descriptor)=> WebGPU_FFI.DeviceCreateTexture(this, descriptor);

	public void Destroy()=> WebGPU_FFI.DeviceDestroy(this);

	public WebGpuSharp.Status GetAdapterInfo(WebGpuSharp.FFI.AdapterInfoFFI* adapterInfo)=> WebGPU_FFI.DeviceGetAdapterInfo(this, adapterInfo);

	public void GetFeatures(WebGpuSharp.FFI.SupportedFeaturesFFI* features)=> WebGPU_FFI.DeviceGetFeatures(this, features);

