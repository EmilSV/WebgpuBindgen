	public WebGpuSharp.Future CreateComputePipelineAsync(WebGpuSharp.FFI.ComputePipelineDescriptorFFI* descriptor, WebGpuSharp.FFI.CreateComputePipelineAsyncCallbackInfo2FFI callbackInfo)=> WebGPU_FFI.DeviceCreateComputePipelineAsync2(this, descriptor, callbackInfo);

	public WebGpuSharp.FFI.PipelineLayoutHandle CreatePipelineLayout(WebGpuSharp.FFI.PipelineLayoutDescriptorFFI* descriptor)=> WebGPU_FFI.DeviceCreatePipelineLayout(this, descriptor);

	public WebGpuSharp.FFI.QuerySetHandle CreateQuerySet(WebGpuSharp.FFI.QuerySetDescriptorFFI* descriptor)=> WebGPU_FFI.DeviceCreateQuerySet(this, descriptor);

	public WebGpuSharp.FFI.RenderBundleEncoderHandle CreateRenderBundleEncoder(WebGpuSharp.FFI.RenderBundleEncoderDescriptorFFI* descriptor)=> WebGPU_FFI.DeviceCreateRenderBundleEncoder(this, descriptor);

	public WebGpuSharp.FFI.RenderPipelineHandle CreateRenderPipeline(WebGpuSharp.FFI.RenderPipelineDescriptorFFI* descriptor)=> WebGPU_FFI.DeviceCreateRenderPipeline(this, descriptor);

