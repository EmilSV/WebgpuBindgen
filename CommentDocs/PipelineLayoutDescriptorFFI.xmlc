<group prefix="WebGpuSharp.FFI.">
    <comment location="PipelineLayoutDescriptorFFI">
        <summary>            
            Describes a PipelineLayout.
        </summary>
    </comment>
    <group prefix="PipelineLayoutDescriptorFFI.">
        <comment location="Label">
            <summary>                
                Debug label of the pipeline layout. This will show up in graphics debuggers for easy identification.
            </summary>
        </comment>
        <comment location="BindGroupLayoutCount">
            <summary>                
                the number of bind groups in the BindGroupLayouts sequence.
            </summary>
        </comment>
        <comment>
            <summary location="BindGroupLayouts">                
                Bind groups that this pipeline uses. The first entry will provide all the bindings for “set = 0”, second entry will provide all the bindings for “set = 1” etc.
            </summary>
        </comment>
        <comment location="ImmediateDataRangeByteSize">
            <obsolete/>
        </comment>
    </group>
</group>