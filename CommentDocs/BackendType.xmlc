<group prefix="WebGpuSharp.">
	<comment location="BackendType">
		<summary>Backends supported by WebGPU</summary>
	</comment>
	<group prefix="BackendType.">
		<comment location="Undefined">
			<summary>No backend is specified. (uses default backend)</summary>
		</comment>
		<comment location="Null">
			<summary>Null backend.</summary>
		</comment>
		<comment location="WebGPU">
			<summary>WebGPU backend.</summary>
		</comment>
		<comment location="D3D11">
			<summary>Direct3D 11 backend.</summary>
		</comment>
		<comment location="D3D12">
			<summary>Direct3D 12 backend.</summary>
		</comment>
		<comment location="Metal">
			<summary>Metal backend.</summary>
		</comment>
		<comment location="Vulkan">
			<summary>Vulkan backend.</summary>
		</comment>
		<comment location="OpenGL">
			<summary>OpenGL backend.</summary>
		</comment>
		<comment location="OpenGLES">
			<summary>OpenGLES backend.</summary>
		</comment>
	</group>
</group>