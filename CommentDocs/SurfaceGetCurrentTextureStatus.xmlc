<group prefix="WebGpuSharp.">
	<comment location="SurfaceGetCurrentTextureStatus">
		<summary>
			The status of the last call to <see cref="Surface.GetCurrentTexture"/>.
		</summary>
	</comment>
	<group prefix="SurfaceGetCurrentTextureStatus.">
		<comment location="Success">
			<summary>
				The call to <see cref="Surface.GetCurrentTexture"/> was successful.
			</summary>
		</comment>
		<comment location="Timeout">
			<summary>
				The call to <see cref="Surface.GetCurrentTexture"/> timed out.
			</summary>
		</comment>
		<comment location="Outdated">
			<summary>
				The call to <see cref="Surface.GetCurrentTexture"/> was outdated.
			</summary>
		</comment>
		<comment location="Lost">
			<summary>
				The call to <see cref="Surface.GetCurrentTexture"/> was lost.
			</summary>
		</comment>
		<comment location="OutOfMemory">
			<summary>
				The call to <see cref="Surface.GetCurrentTexture"/> failed due to out of memory.
			</summary>
		</comment>
		<comment location="DeviceLost">
			<summary>
				The call to <see cref="Surface.GetCurrentTexture"/> failed due to the device being lost.
			</summary>
		</comment>
		<comment location="Error">
			<summary>
				The call to <see cref="Surface.GetCurrentTexture"/> failed due to an error.
			</summary>
		</comment>
		<comment location="SuccessOptimal">
			<summary>
				The call to <see cref="Surface.GetCurrentTexture"/> was successful and the texture is optimal.
			</summary>
		</comment>
		<comment location="SuccessSuboptimal">
			<summary>
				The call to <see cref="Surface.GetCurrentTexture"/> was successful and the texture is suboptimal.
			</summary>
		</comment>
	</group>
</group>