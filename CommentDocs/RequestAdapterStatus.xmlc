<group prefix="WebGpuSharp.">
    <comment location="RequestAdapterStatus">
        <summary>            
            Describes the status of a request to get an adapter.
        </summary>
    </comment>
	<group prefix="RequestAdapterStatus.">
		<comment location="Success">
			<summary>
				The request was completed successfully.
			</summary>
		</comment>
		<comment location="InstanceDropped">
			<summary>
				The instance was dropped before the request could be completed.
			</summary>
		</comment>
		<comment location="Unavailable">
			<summary>
				No adapter could be found that matches the request.
			</summary>
		</comment>
		<comment location="Error">
			<summary>
				An error occurred while requesting the adapter.
			</summary>
		</comment>
		<comment location="Unknown">
			<summary>
				An unknown error occurred.
			</summary>
		</comment>
		<comment location="CallbackCancelled">
			<summary>
				The callback was cancelled.
			</summary>
		</comment>
	</group>
</group>