<group prefix="WebGpuSharp.">
	<comment location="CompilationInfoRequestStatus">
		<summary>
			CompilationInfoRequestStatus is used to indicate the status of a GetCompilationInfo	 request.
		</summary>
	</comment>
	<group prefix="CompilationInfoRequestStatus.">
		<comment location="Success">
			<summary>Compilation succeeded.</summary>
		</comment>
		<comment location="CallbackCancelled">
			<summary>Compilation was cancelled</summary>
		</comment>
	</group>
</group>