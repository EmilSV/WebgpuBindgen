<group prefix="WebGpuSharp.FFI.">
	<comment location="CompilationMessageFFI">
		<summary> CompilationMessageFFI represents a single informational, warning, or error message
			generated by the GPU shader module compiler. </summary>
	</comment>
	<group prefix="CompilationMessageFFI.">
		<comment location="Message">
			<summary>A string representing human-readable message text.</summary>
		</comment>
		<comment location="Type">
			<summary>Severity level of the message.</summary>  
		</comment>
		<comment location="LineNum">
			<summary>Line number where the message is attached, starting at 1.</summary>
		</comment>
		<comment location="LinePos">
			<summary>Offset in UTF-8 code units (bytes) from the beginning of the line, starting at 1.</summary>
		</comment>
		<comment location="Offset">
			<summary>Offset in UTF-8 code units (bytes) from the beginning of the shader code, starting at 0.</summary>
		</comment>
		<comment location="Length">
			<summary>Length in UTF-8 code units (bytes) of the span the message corresponds to.</summary>
		</comment>
		<comment location="Utf16LinePos">
			<obsolete/>
		</comment>
		<comment location="Utf16Offset">
			<obsolete/>
		</comment>
		<comment location="Utf16Length">
			<obsolete/>
		</comment>
	</group>
</group>