<!-- 
	TODO: use more from https://www.w3.org/TR/webgpu/#limits
-->


<group prefix="WebGpuSharp.">
    <comment location="Limits">
        <summary>            
            Each limit is a numeric limit on the usage of WebGPU on a device.
        </summary>
    </comment>
    <group prefix="Limits.">
        <comment location="MaxTextureDimension1D">
            <summary> Maximum allowed value for the size.Width of a texture created with <see cref="WebGpuSharp.TextureDimension.D1"/>. Defaults to 8192. Higher is “better”.</summary>
        </comment>
        <comment location="MaxTextureDimension2D">
            <summary> Maximum allowed value for the size.Width and size.Height of a texture created with <see cref="WebGpuSharp.TextureDimension.D2"/>. Defaults to 8192. Higher is “better”. </summary>
        </comment>
        <comment location="MaxTextureDimension3D">
            <summary> Maximum allowed value for the size.Width, size.Height, and size.DepthOrArrayLayers of a texture created with <see cref="WebGpuSharp.TextureDimension.D3"/>. Defaults to 2048. Higher is “better”. </summary>
        </comment>
        <comment location="MaxTextureArrayLayers">
            <summary> Maximum allowed value for the size.DepthOrArrayLayers of a texture created with <see cref="WebGpuSharp.TextureDimension.D2"/>. Defaults to 256. Higher is “better”. </summary>
        </comment>
        <comment location="MaxBindGroups">
            <summary> Amount of bind groups that can be attached to a pipeline at the same time. Defaults to 4. Higher is “better”. </summary>
        </comment>
        <comment location="MaxBindGroupsPlusVertexBuffers">
            <summary>The maximum number of bind group and vertex buffer slots used simultaneously, counting any empty slots below the highest index. Validated in CreateRenderPipeline() and in draw calls. </summary>
        </comment>
        <comment location="MaxBindingsPerBindGroup">
            <summary>Maximum binding index allowed in CreateBindGroupLayout. Defaults to 1000. Higher is “better”.</summary>
        </comment>
        <comment location="MaxDynamicUniformBuffersPerPipelineLayout">
            <summary>Amount of uniform buffer bindings that can be dynamic in a single pipeline. Defaults to 8. Higher is “better”.</summary>
        </comment>
        <comment location="MaxDynamicStorageBuffersPerPipelineLayout">
            <summary>Amount of storage buffer bindings that can be dynamic in a single pipeline. Defaults to 4. Higher is “better”.</summary>
        </comment>
        <comment location="MaxSampledTexturesPerShaderStage">
            <summary>Amount of sampled textures visible in a single shader stage. Defaults to 16. Higher is “better”.</summary>
        </comment>
        <comment location="MaxSamplersPerShaderStage">
            <summary>Amount of samplers visible in a single shader stage. Defaults to 16. Higher is “better”.</summary>
        </comment>
        <comment location="MaxStorageBuffersPerShaderStage">
            <summary>Amount of storage buffers visible in a single shader stage. Defaults to 8. Higher is “better”.</summary>
        </comment>
        <comment location="MaxStorageTexturesPerShaderStage">
            <summary>Amount of storage textures visible in a single shader stage. Defaults to 4. Higher is “better”.</summary>
        </comment>
        <comment location="MaxUniformBuffersPerShaderStage">
            <summary>Amount of uniform buffers visible in a single shader stage. Defaults to 12. Higher is “better”.</summary>
        </comment>
        <comment location=" MaxUniformBufferBindingSize">
            <summary>Maximum size in bytes of a binding to a uniform buffer. Defaults to 64 KiB. Higher is “better”.</summary>
        </comment>
        <comment location=" MaxStorageBufferBindingSize">
            <summary>Maximum size in bytes of a binding to a storage buffer. Defaults to 128 MiB. Higher is “better”.</summary>
        </comment>
        <comment location="MinUniformBufferOffsetAlignment">
            <summary>The required alignment for BufferBinding.Offset and the dynamic offsets provided in SetBindGroup(), for bindings with a BindGroupLayoutEntry entry for which Entry.Buffer.Type is "uniform". </summary>
        </comment>
        <comment location="MinStorageBufferOffsetAlignment">
            <summary>The required alignment for BufferBinding.Offset and the dynamic offsets provided in SetBindGroup(), for bindings with a BindGroupLayoutEntry entry for which Entry.Buffer.Type is "storage" or "read-only-storage". </summary>
        </comment>
        <comment location="MaxVertexBuffers">
            <summary>Maximum length of VertexState.Buffers when creating a RenderPipeline. Defaults to 8. Higher is “better”.</summary>
        </comment>
        <comment location=" MaxBufferSize">
            <summary>
				A limit above which buffer allocations are guaranteed to fail. Defaults to 256 MiB. Higher is “better”.

				Buffer allocations below the maximum buffer size may not succeed depending on available memory, fragmentation and other factors.
			</summary>
        </comment>
        <comment location="MaxVertexAttributes">
            <summary>Maximum length of VertexBufferLayout.Attributes, summed over all VertexState.Buffers, when creating a RenderPipeline. Defaults to 16. Higher is “better”.</summary>
        </comment>
        <comment location="MaxVertexBufferArrayStride">
            <summary>Maximum value for VertexBufferLayout.ArrayStride when creating a RenderPipeline. Defaults to 2048. Higher is “better”.</summary>
        </comment>
        <comment location="MaxInterStageShaderComponents">
            <summary>Maximum allowed number of components (scalars) of input or output locations for inter-stage communication (vertex outputs to fragment inputs). Defaults to 60. Higher is “better”.</summary>
        </comment>
        <comment location="MaxInterStageShaderVariables">
            <summary>The maximum allowed number of input or output variables for inter-stage communication (like vertex outputs or fragment inputs). Defaults to 16. Higher is “better”.</summary>
        </comment>
        <comment location="MaxColorAttachments">
            <summary>The maximum allowed number of color attachments.</summary>
        </comment>
        <comment location="MaxColorAttachmentBytesPerSample">
            <summary>The maximum number of bytes necessary to hold one sample (pixel or subpixel) of render pipeline output data, across all color attachments. Defaults to 32. Higher is “better”.</summary>
        </comment>
        <comment location="MaxComputeWorkgroupStorageSize">
            <summary>Maximum number of bytes used for workgroup memory in a compute entry point. Defaults to 16384. Higher is “better”.</summary>
        </comment>
        <comment location="MaxComputeInvocationsPerWorkgroup">
            <summary>Maximum value of the product of the workgroup_size dimensions for a compute entry-point. Defaults to 256. Higher is “better”.</summary>
        </comment>
        <comment location="MaxComputeWorkgroupSizeX">
            <summary>The maximum value of the workgroup_size X dimension for a compute stage ShaderModule entry-point. Defaults to 256. Higher is “better”.</summary>
        </comment>
        <comment location="MaxComputeWorkgroupSizeY">
            <summary>The maximum value of the workgroup_size Y dimension for a compute stage ShaderModule entry-point. Defaults to 256. Higher is “better”.</summary>
        </comment>
        <comment location="MaxComputeWorkgroupSizeZ">
            <summary>The maximum value of the workgroup_size Z dimension for a compute stage ShaderModule entry-point. Defaults to 64. Higher is “better”.</summary>
        </comment>
        <comment location="MaxComputeWorkgroupsPerDimension">
            <summary>The maximum value for each dimension of a ComputePass.Dispatch(x, y, z) operation. Defaults to 65535. Higher is “better”.</summary>
        </comment>

        <comment location="MaxStorageBuffersInVertexStage"> 
            <summary></summary>
        </comment>
        <comment location="MaxStorageTexturesInVertexStage"> 
            <summary></summary>
        </comment>
        <comment location="MaxStorageBuffersInFragmentStage"> 
            <summary></summary>
        </comment>
        <comment location="MaxStorageTexturesInFragmentStage"> 
            <summary></summary>
        </comment>
    </group>
</group>