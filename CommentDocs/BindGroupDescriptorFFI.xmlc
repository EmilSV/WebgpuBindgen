<group prefix="WebGpuSharp.FFI.">
	<comment location="BindGroupDescriptorFFI">
		<summary>
			Describes a group of bindings and the resources to be bound.
		</summary>
	</comment>

	<group prefix="BindGroupDescriptorFFI.">
		<comment location="Label">
			<summary>
				Debug label of the bind group
			</summary>
		</comment>
		<comment location="Layout">
			<summary>
				The <see cref="WebGpuSharp.BindGroupLayout" /> the entries of
				this bind group will conform to.
			</summary>
		</comment>
		<comment location="EntryCount">
			<summary>
				the number of entries at <see cref="WebGpuSharp.FFI.BindGroupDescriptorFFI.Entries" />
			</summary>
		</comment>
	</group>

</group>